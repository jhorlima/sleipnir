# Local development only. Credentials are intentionally obvious; never reuse them elsewhere.

# Image tags
RUSTFS_VERSION=1.0.1
POSTGRES_VERSION=18.6
LAKEKEEPER_VERSION=v0.14.0
TRAEFIK_VERSION=v3.7.14
AWS_CLI_VERSION=2.37.12
TRINO_VERSION=483

# Object storage (RustFS)
S3_REGION=local-01
S3_BUCKET=lakehouse
S3_ACCESS_KEY=rustfs-local-user
S3_SECRET_KEY=rustfs-local-password

# Postgres (Lakekeeper metadata)
POSTGRES_PASSWORD=postgres-local-password
LAKEKEEPER_DB_PASSWORD=lakekeeper-local-password

# Lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=lakekeeper-local-encryption-key
LAKEKEEPER_WAREHOUSE=lakehouse

# Ingestion (GHCN-Daily into duckdb_bronze)
INGEST_VERSION=0.1.0
# Scale r2 (SPEC §6); dbt-backfill's BACKFILL_START/BACKFILL_END match these years.
GHCN_YEARS=2010 2011 2012 2013 2014 2015 2016 2017 2018 2019 2020 2021 2022 2023 2024 2025
LANDING_DIR=./landing
STORAGE_BUDGET_GB=10

# Transformation (dbt; DBT_THREADS comes from env/<profile>.env)
DBT_VERSION=0.1.0
DBT_TARGET=trino

# Semantic layer (Cube + Cube Store share one version; suffix -arm64v8 on Apple Silicon, empty on amd64)
CUBE_VERSION=v1.7.50
CUBESTORE_ARCH_SUFFIX=-arm64v8
CUBEJS_API_SECRET=cube-local-api-secret
CUBE_SQL_PASSWORD=cube-local-sql-password
GOLD_NAMESPACE=trino_gold
