# Local development only. Credentials are intentionally obvious; never reuse them elsewhere.

# Image tags
RUSTFS_VERSION=1.0.1
POSTGRES_VERSION=18.6
LAKEKEEPER_VERSION=v0.14.0
TRAEFIK_VERSION=v3.7.14
AWS_CLI_VERSION=2.37.12

# Object storage (RustFS)
S3_REGION=local-01
S3_BUCKET=lakehouse
S3_ACCESS_KEY=rustfs-local-user
S3_SECRET_KEY=rustfs-local-password

# Postgres (Lakekeeper metadata)
POSTGRES_PASSWORD=postgres-local-password
LAKEKEEPER_DB_PASSWORD=lakekeeper-local-password

# Lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=lakekeeper-local-encryption-key
LAKEKEEPER_WAREHOUSE=lakehouse
