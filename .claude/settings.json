{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make storage-report *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker stats --no-stream *)",
      "Bash(bash -n *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(results/**)",
      "Write(results/**)",
      "Bash(rm -rf *)",
      "Bash(docker system prune *)",
      "Bash(docker volume prune *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-edit.sh\""
          }
        ]
      }
    ]
  }
}
