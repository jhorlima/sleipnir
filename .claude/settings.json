{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make storage-report ENGINE=trino)",
      "Bash(make storage-report ENGINE=spark)",
      "Bash(docker compose config -q)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker stats --no-stream)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log --oneline)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(results/**)",
      "Write(results/**)",
      "Bash(rm -rf *)",
      "Bash(docker system prune *)",
      "Bash(docker volume prune *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-edit.sh\""
          }
        ]
      }
    ]
  }
}
