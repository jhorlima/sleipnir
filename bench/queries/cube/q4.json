{
  "measures": ["trino_weather.observation_count", "trino_weather.avg_tmax"],
  "dimensions": ["trino_weather.country"],
  "filters": [
    {"member": "trino_weather.latitude", "operator": "gte", "values": ["36"]},
    {"member": "trino_weather.latitude", "operator": "lte", "values": ["44"]},
    {"member": "trino_weather.longitude", "operator": "gte", "values": ["-10"]},
