ENGINE_CPUS=8
ENGINE_MEMORY=12g
DBT_THREADS=4
# Second profile-L campaign (SPEC D-26): the same engine limits as l.env on a revised object store (V15).
# 8 engine CPUs + 2 RustFS CPUs = the 10 CPUs of the Docker VM, so the two never compete.
RUSTFS_VERSION=1.0.2
RUSTFS_CPUS=2
RUSTFS_MEMORY=5g
RUSTFS_SCANNER_ENABLED=false
